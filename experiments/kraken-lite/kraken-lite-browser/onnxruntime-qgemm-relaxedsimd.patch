   endif()
diff --git a/cmake/onnxruntime_mlas.cmake b/cmake/onnxruntime_mlas.cmake
index 8decca1..f532207 100644
--- a/cmake/onnxruntime_mlas.cmake
+++ b/cmake/onnxruntime_mlas.cmake
@@ -292,6 +292,14 @@ if (CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
         ${mlas_platform_srcs}
         ${MLAS_SRC_DIR}/qgemm_kernel_wasmrelaxedsimd.cpp
       )
+      # Relaxed SIMD only accelerates the unsigned QGEMM dispatch used by the
+      # quantized LSTM. Keep it off the rest of ORT so toggling this option
+      # rebuilds two MLAS files instead of the entire runtime.
+      set_source_files_properties(
+        ${MLAS_SRC_DIR}/qgemm.cpp
+        ${MLAS_SRC_DIR}/qgemm_kernel_wasmrelaxedsimd.cpp
+        PROPERTIES COMPILE_OPTIONS "-mrelaxed-simd"
+      )
     endif()
   else()
     file(GLOB_RECURSE mlas_platform_srcs
